# Server
PORT=8000
WEBHOOK_URL=https://your-public-domain.example
DATABASE_URL=sqlite:///./data/vocab.db
SECRET_KEY=change-this-in-production

# API Keys - Replace with real values in .env (never commit real keys)
TAVILY_API_KEY=your-tavily-key-here
QWEN_API_KEY=your-qwen-key-here
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_DELIVERY=polling
# Options: polling for local Telegram, webhook for public HTTPS, disabled for backend tests.
OPENCLAW_WEBHOOK_SECRET=your-random-secret-here
